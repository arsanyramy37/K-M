rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Dedicated collection for Kerollos & Mariam wishes
    match /kerollos_mariam_wishes/{wishId} {
      // 1. Allow everyone to view wishes
      allow read: if true;

      // 2. Allow submitting a new wish ONLY if it meets strict validation:
      //    - Must contain only the expected fields: name, message, createdAt
      //    - Name must be a non-empty string up to 80 characters
      //    - Message must be a non-empty string up to 1000 characters
      //    - createdAt must be a valid timestamp
      allow create: if request.resource.data.keys().hasAll(['name', 'message', 'createdAt'])
                    && request.resource.data.keys().hasOnly(['name', 'message', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 1000
                    && request.resource.data.createdAt is timestamp;

      // 3. NEVER allow any updates or deletions via client SDK
      //    This ensures messages stay permanently and can never be deleted or tampered with
      allow update, delete: if false;
    }

    // Default deny for all other paths and collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
